# Kometa fills <<placeholders>> in config.yml from KOMETA_* variables. Put a file like this next to each
# server's config.yml (as .env) or pass the variables to the container. Never commit the real file.
KOMETA_PLEX_URL=http://your-plex-server:32400
KOMETA_PLEX_TOKEN=your-plex-token
KOMETA_TMDB_APIKEY=your-tmdb-api-key
KOMETA_MDBLIST_APIKEY=your-mdblist-api-key
